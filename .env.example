# PromptShield Environment Configuration
# Copy this file to .env and configure your desired LLM provider.

# Active LLM Provider: 'gemini', 'openai', 'ollama', or 'fixture' (offline deterministic mode)
DEFAULT_PROVIDER=fixture

# Model selection per provider
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3.2:latest

# API Keys (leave blank if using 'ollama' or 'fixture')
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ollama Local Service URL
OLLAMA_BASE_URL=http://localhost:11434

# Server Configuration
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=promptshield.db
LOG_LEVEL=INFO
